{
  "name": "dipsaus-orchestrator",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "contract:schema": "bun packages/contract/scripts/write-schema.ts",
    "test": "bun test",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "backlog.md": "1.53.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
