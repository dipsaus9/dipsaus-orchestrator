    "mergeSlot": {
      "type": "object",
      "properties": {
        "requiredChecks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Checks the merge slot waits for before it merges a PR of this office (0016 rule 2): each must pass, and any failed or cancelled check holds the PR back. Names are the check names the host reports, such as ci-ok and pr-title. A repository whose CI names other checks sets its own names here."
        },
        "autoMerge": {
          "type": "boolean",
          "description": "Whether the merge slot merges a PR once its checks pass and it is reviewed."
        },
        "conflictAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Attempts to rebase a PR onto a base that moved, before the merge slot gives up on it."
        },
        "ciAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Attempts to fix a PR whose required check failed, before the merge slot gives up on it."
        },
        "holdLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Labels that hold a PR back from the merge slot while it carries one."
        },
        "checksWaitMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Minutes the merge slot waits for the required checks of a PR to finish before it reports them stuck."
        }
