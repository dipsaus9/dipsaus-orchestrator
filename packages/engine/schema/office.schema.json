{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 14
    },
    "tiers": {
      "type": "object",
      "properties": {
        "S": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "budgetTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxMinutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "loops": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "M": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "budgetTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxMinutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "loops": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "L": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "budgetTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxMinutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "loops": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "maxRounds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "budgetTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "Limits of the review loop (0002): the model and effort of the review worker, the rounds of review and fixes before it stops, and the turns, minutes and tokens of one review."
    },
    "caps": {
      "type": "object",
      "properties": {
        "ciAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Pushed heads with red required checks before the story parks with the reason verify-failing. A reviewed head and a close-out head each count once their checks are red; a head whose CI run a later push cancelled does not count."
        },
        "conflictAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Failed conflict hand-offs of a story before it parks with the reason conflict."
        }
      },
      "additionalProperties": false,
      "description": "How often a story may try again before it parks (0002)."
    },
    "merge": {
      "type": "object",
      "properties": {
        "autoMerge": {
          "type": "boolean",
          "description": "Whether dipo commits the close-out and turns GitHub's auto-merge on for a story PR as soon as its review approves it, without the maintainer's approval. GitHub merges it once its required checks pass on the close-out head."
        },
        "holdLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Labels that keep auto-merge off for a PR while it carries one."
        },
        "checksWaitMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Minutes dipo waits for the required checks of a PR to finish before it reports them stuck and polls the PR less often."
        }
      },
      "additionalProperties": false,
      "description": "How a story PR merges (0002)."
    },
    "box": {
      "type": "object",
      "properties": {
        "debian": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.]*$",
          "description": "The Debian release of the box image. dipo builds on its slim image, docker.io/library/debian:<release>-slim, pinned by digest for trixie, dipo's default; another release is pulled by its tag alone."
        },
        "toolchain": {
          "type": "object",
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Node.js, from nodejs.org; npm comes with it. Every box has Node, because npm installs Claude Code."
            },
            "bun": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Bun, from npm through Safe-Chain."
            },
            "pnpm": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "pnpm, from npm through Safe-Chain."
            },
            "yarn": {
              "type": "string",
              "minLength": 1,
              "pattern": "^1\\.\\d+\\.\\d+$",
              "description": "Yarn 1, from npm through Safe-Chain. A Yarn 2+ repository runs its committed yarnPath release through it."
            },
            "nodeSha256": {
              "type": "object",
              "properties": {
                "arm64": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "x64": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false,
              "description": "The sha256 of the Node.js tarball (node-v<version>-linux-<arch>.tar.gz) per architecture. dipo pins it for its known Node versions; a Node version it does not know needs it here, or the build is refused."
            }
          },
          "additionalProperties": false,
          "description": "The toolchain of the box image and its exact versions. A version left out is detected from the repository (.bun-version, packageManager, .node-version, .nvmrc) or takes dipo's default."
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9+.-]+(?:=[A-Za-z0-9.+~:-]+)?$"
          },
          "description": "Extra Debian packages of the box image, installed with apt from Debian's archive."
        },
        "claudeCode": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "The Claude Code version of the box image, installed from npm through Safe-Chain, with its auto-update and nonessential traffic turned off (0008)."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "noRealSecrets": {
                "type": "boolean",
                "const": true,
                "description": "Must be true: the maintainer's mark that the file holds no real secrets (0008). An entry without it is refused."
              }
            },
            "required": ["path", "noRealSecrets"],
            "additionalProperties": false,
            "description": "A file outside git that a box gets, by its path in the repository."
          },
          "description": "Files outside git that a box may get (0008). Nothing outside git goes into a box unless it is listed here and marked noRealSecrets: true. Their values are redacted from PR comments and stored web calls."
        },
        "localPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "description": "Local ports of this Mac a box may reach (0008), only through dipo's web proxy, as host.dipo.internal:<port>, which dipo connects to on the Mac's loopback. No other service on the Mac or its local network is reachable from a box. Empty by default."
        }
      },
      "additionalProperties": false,
      "description": "The office's box (0008): the image every story's box runs and the files outside git it may get. dipo reads this block from the base branch only, so a story cannot change it. What it leaves out is detected from the repository; the image is built once per description and rebuilt only when the description changes."
    },
    "scan": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "The model of the scan fallback session."
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "description": "The effort of the scan fallback session."
        },
        "budgetTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Input plus output plus cache-creation tokens one fallback session may spend."
        },
        "maxMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Minutes one fallback session may run before dipo stops it."
        }
      },
      "additionalProperties": false,
      "description": "The fallback session that proposes the run profile capabilities code could not resolve, started only by dipo office infer (0013). It runs on the Mac with every tool off, one turn plus one schema retry."
    },
    "story": {
      "type": "object",
      "properties": {
        "types": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tiers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["S", "M", "L"]
          }
        },
        "bannedPhrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "securityPhrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Phrases of a title or Outcome that adds or replaces a security barrier, such as a deny rule or a permission check. Such a story needs the criteria parts of story.securityCriteriaPhrases, else it fails the Ready gate (R30, 0012)."
        },
        "securityCriteriaPhrases": {
          "type": "object",
          "properties": {
            "oldBarrier": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Phrases of a criterion that lists what the old barrier caught, with a test for each."
            },
            "bypassForms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Phrases of a criterion that lists the bypass forms to test (wrappers, quoting, indirection, chaining)."
            },
            "failClosed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Phrases of a criterion that asks for a fail-closed test against the real path."
            }
          },
          "additionalProperties": false,
          "description": "Per part of R30, the phrases a criterion must contain (word match, as R10). A story whose title or Outcome names a security barrier fails once for each part no criterion matches (0012)."
        },
        "titleMax": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcomeMin": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "criterionMin": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "slugMax": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
