    "worker": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "allowProjectSettings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "description": "Plugins a worker session may load, as <plugin>@<marketplace> (0008 amendment of 2026-10-12). Every other installed plugin is switched off in the run settings, and a session whose system/init lists one refuses to start. A listed plugin brings its hooks, which run outside the sandbox, so listing one is reviewed like code."
        },
        "web": {
          "type": "boolean",
          "description": "Whether the developer role gets WebSearch and WebFetch (0020 section 11b). Every call shows in the worker output and is counted on the run outcome, and a PreToolUse hook refuses a URL or query that holds a value from the copied env files, and a WebFetch whose host is not on the public internet (an IP address, or a name that resolves to this Mac, its local network or another non-public range). The Bash sandbox network stays closed. With false the developer keeps the M0 tool list. The key does not apply to the reviewer, which always has WebSearch and WebFetch under the same checks (0021 section 10)."
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "enum": ["when-present", "never"]
        }
      },
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object",
