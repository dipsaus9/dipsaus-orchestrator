        },
        "securityPhrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Phrases of a title or Outcome that adds or replaces a security barrier, such as a deny rule or a permission check. Such a story needs the criteria parts of story.securityCriteriaPhrases, else it fails the Ready gate (R30, 0012 section 3, DIPO-251)."
        },
