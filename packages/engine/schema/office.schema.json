    "worker": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "allowProjectSettings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^@\\s]+@[^@\\s]+$"
          },
          "description": "Plugins a worker session may load, as <plugin>@<marketplace> (0008 amendment of 2026-10-12). Every other installed plugin is switched off in the run settings, and a session whose system/init lists one refuses to start. A listed plugin brings its hooks, which run outside the sandbox, so listing one is reviewed like code."
        },
        "web": {
          "type": "boolean",
          "description": "Whether the developer role gets the web search and fetch tools (0020 section 11b). Every call shows in the worker output and is counted on the run outcome; the box's web traffic goes through dipo's web proxy (0008). With false the developer keeps the M0 tool list. The key does not apply to the reviewer, which always has them in its reviewer box (0002)."
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
