    "storyPr": {
      "type": "object",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "Whether the engine opens the story PR at the first In Review push and keeps it updated (0019 section 3). With false it opens, updates, polls and retries no story PR for this office and raises no pr.openFailed notice; the story stays In Review."
