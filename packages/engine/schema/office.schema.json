          "type": "object",
          "properties": {
            "oldBarrier": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Phrases of a criterion that lists what the old barrier caught, with a test for each."
            },
            "bypassForms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Phrases of a criterion that lists the bypass forms to test (wrappers, quoting, indirection, chaining)."
            },
            "failClosed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Phrases of a criterion that asks for a fail-closed test against the real path."
            }
          },
          "additionalProperties": false,
          "description": "Per part of R30, the phrases a criterion must contain (word match, as R10). A story whose title or Outcome names a security barrier fails once for each part no criterion matches (0012 section 3, DIPO-251)."
        }
      },
      "additionalProperties": false
