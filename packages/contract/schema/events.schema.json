{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dipo contract 1.0: event data",
  "$comment": "Generated by `bun run contract:schema`. Do not edit by hand.",
  "$defs": {
    "office.registered.data": {
      "type": "object",
      "properties": {
        "office": {
          "type": "string",
          "pattern": "^off_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["office", "path", "name"]
    },
    "office.forgotten.data": {
      "type": "object",
      "properties": {
        "office": {
          "type": "string",
          "pattern": "^off_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": ["office"]
    },
    "office.summary.data": {
      "type": "object",
      "properties": {
        "office": {
          "type": "string",
          "pattern": "^off_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "onHold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "waitingOnMaintainer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["office", "name", "path", "running", "parked", "onHold", "waitingOnMaintainer"]
    },
    "daemon.state.data": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "enum": ["starting", "recovering", "running", "draining", "safe"]
        },
        "to": {
          "type": "string",
          "enum": ["starting", "recovering", "running", "draining", "safe"]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["from", "to"]
    },
    "scan.finished.data": {
      "type": "object",
      "properties": {
        "scripts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["scripts", "warnings"]
    },
    "engine.notice.data": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["info", "warn", "error"]
        },
        "code": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["level", "code", "text"]
    },
    "stream.mark.data": {
      "type": "object",
      "properties": {
        "caughtUp": {
          "type": "boolean"
        }
      }
    }
  }
}
